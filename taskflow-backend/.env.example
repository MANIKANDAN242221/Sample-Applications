# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Number of reverse-proxy hops to trust for client IP (0 = none)
TRUST_PROXY=0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_LEVEL=debug
# Human-readable logs (requires dev dependency pino-pretty). Use false in production.
LOG_PRETTY=true

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_STATEMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=taskflow:

# ---------------------------------------------------------------
# JWT (generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-client

# ---------------------------------------------------------------
# Refresh-token cookie
# For a frontend on a different site in production use: COOKIE_SECURE=true, COOKIE_SAMESITE=none
# ---------------------------------------------------------------
REFRESH_COOKIE_NAME=tf_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------
# Security / rate limiting / cache
# ---------------------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------
# Seed script (npm run seed)
# ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@taskflow.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Admin
SEED_DEMO_DATA=true
